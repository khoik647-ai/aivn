{
  "name": "aivn",
  "productName": "AIVN",
  "version": "0.14.4",
  "description": "AIVN - Chạy mô hình AI ngay trên máy tính của bạn",
  "author": {
    "name": "NGUYỄN NGỌC KHÔI SINH VIÊN VLU"
  },
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:mac": "node build/mac-build.cjs"
  },
  "dependencies": {
    "@node-llama-cpp/mac-arm64-metal": "3.22.2",
    "@node-llama-cpp/mac-x64": "3.22.2",
    "@node-llama-cpp/win-x64": "3.22.2",
    "@node-llama-cpp/win-x64-vulkan": "3.22.2",
    "@nut-tree-fork/libnut-darwin": "2.7.5",
    "@nut-tree-fork/libnut-linux": "2.7.5",
    "@nut-tree-fork/libnut-win32": "2.7.5",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/vie": "1.0.0",
    "electron-updater": "6.8.9",
    "mammoth": "1.13.0",
    "node-llama-cpp": "3.22.2",
    "pdfjs-dist": "5.6.205",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "vn.aivn.desktop",
    "productName": "AIVN",
    "copyright": "© 2026 AIVN · NGUYỄN NGỌC KHÔI SINH VIÊN VLU",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icons/**",
      "package.json",
      "!node_modules/@node-llama-cpp/*-cuda*/**",
      "!node_modules/@node-llama-cpp/linux-arm*/**",
      "!node_modules/@node-llama-cpp/linux-armv7l/**",
      "!node_modules/@node-llama-cpp/*riscv*/**",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/node-llama-cpp/llama/**/*.{c,cpp,h,hpp,cu,metal,comp,glsl}",
      "!**/*.map",
      "!node_modules/pdfjs-dist/{web,image_decoders,types,build}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!node_modules/pdfjs-dist/legacy/build/pdf.sandbox*",
      "!test/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/@tesseract.js-data/*/4.0.0/**",
      "!node_modules/tesseract.js/{dist,docs,examples,benchmarks,tests}/**",
      "!node_modules/@nut-tree-fork/*/build/Release/*.{lib,exp}"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**",
      "src/engine.js",
      "src/engine-host.js",
      "src/vision-server.js",
      "src/agent/textproto.js",
      "src/schema.js",
      "src/ocr.js",
      "src/llama-archs.json",
      "package.json"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/@node-llama-cpp/linux-*/**",
        "!node_modules/@node-llama-cpp/mac-*/**",
        "!node_modules/@reflink/reflink-linux-*/**",
        "!node_modules/@reflink/reflink-darwin-*/**",
        "!node_modules/@nut-tree-fork/libnut-linux/**",
        "!node_modules/@nut-tree-fork/libnut-darwin/**"
      ],
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": "NGUYỄN NGỌC KHÔI SINH VIÊN VLU"
      },
      "verifyUpdateCodeSignature": false,
      "extraResources": [
        {
          "from": "build/node/win-x64",
          "to": "node",
          "filter": [
            "node",
            "node.exe",
            "LICENSE"
          ]
        },
        {
          "from": "build/llama/win-x64",
          "to": "llama",
          "filter": [
            "**/*",
            "!.build"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIVN",
      "artifactName": "AIVN-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/license.txt"
    },
    "portable": {
      "artifactName": "AIVN-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "files": [
        "!node_modules/@node-llama-cpp/win-*/**",
        "!node_modules/@node-llama-cpp/mac-*/**",
        "!node_modules/@nut-tree-fork/libnut-win32/**",
        "!node_modules/@nut-tree-fork/libnut-darwin/**"
      ],
      "artifactName": "AIVN-${version}-${arch}.${ext}",
      "maintainer": "NGUYỄN NGỌC KHÔI SINH VIÊN VLU",
      "desktop": {
        "entry": {
          "Name": "AIVN",
          "Comment": "Chạy mô hình AI ngay trên máy tính"
        }
      },
      "extraResources": [
        {
          "from": "build/node/linux-x64",
          "to": "node",
          "filter": [
            "node",
            "node.exe",
            "LICENSE"
          ]
        },
        {
          "from": "build/llama/linux-x64",
          "to": "llama",
          "filter": [
            "**/*",
            "!.build"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 AIVN · NGUYỄN NGỌC KHÔI SINH VIÊN VLU",
        "NSAppleEventsUsageDescription": "AIVN BOT cần quyền này để mở, đóng ứng dụng và thực hiện thao tác bạn đã đồng ý.",
        "NSScreenCaptureUsageDescription": "AIVN BOT chụp màn hình để đề xuất thao tác (chế độ Điều khiển màn hình thử nghiệm)."
      },
      "files": [
        "!node_modules/@node-llama-cpp/win-*/**",
        "!node_modules/@node-llama-cpp/linux-*/**",
        "!node_modules/@reflink/reflink-linux-*/**",
        "!node_modules/@reflink/reflink-win32-*/**",
        "!node_modules/@nut-tree-fork/libnut-linux/**",
        "!node_modules/@nut-tree-fork/libnut-win32/**"
      ],
      "artifactName": "AIVN-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "khoik647-ai",
        "repo": "aivn",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "aivn.desktop"
}
