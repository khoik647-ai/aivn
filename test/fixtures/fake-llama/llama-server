#!/usr/bin/env node
// llama-server giả: /health và /props vẫn trả {}. Có --embeddings thì /v1/embeddings, /embedding và /tokenize trả vector cố định.
// -ub (mặc định 512, như llama-server khi không truyền -ub): input nhiều từ hơn mức này bị từ chối.
const http = require('http');
const fs = require('fs');
const port = Number(process.argv[process.argv.indexOf('--port') + 1]);
if (process.env.AIVN_FAKE_SPAWN_LOG) {
  try { fs.appendFileSync(process.env.AIVN_FAKE_SPAWN_LOG, JSON.stringify({ pid: process.pid, argv: process.argv.slice(2), t: Date.now() }) + '\n'); } catch {}
}
if (process.env.AIVN_FAKE_FAIL_ONCE) {
  const mark = process.env.AIVN_FAKE_FAIL_ONCE;
  try {
    if (!fs.existsSync(mark)) { fs.writeFileSync(mark, String(process.pid)); process.exit(1); }
  } catch { process.exit(1); }
}
const healthDelay = Number(process.env.AIVN_FAKE_HEALTH_MS || 0);
function argNum(name, dflt) {
  const i = process.argv.indexOf(name);
  if (i < 0) return dflt;
  const n = Number(process.argv[i + 1]);
  return Number.isFinite(n) ? n : dflt;
}
const ub = argNum('-ub', 512);
let lastWords = [];
function readBody(q) {
  return new Promise((resolve) => {
    const c = []; q.on('data', (d) => c.push(d)); q.on('end', () => { try { resolve(JSON.parse(Buffer.concat(c).toString() || '{}')); } catch { resolve({}); } });
    q.on('error', () => resolve({}));
  });
}
function words(t) { return String(t).split(/\s+/).filter(Boolean); }
function vec(text) {
  const v = new Array(8).fill(0);
  const s = String(text);
  for (let i = 0; i < s.length; i++) v[i % 8] += s.charCodeAt(i);
  let n = 0; for (const x of v) n += x * x; n = Math.sqrt(n) || 1;
  return v.map((x) => x / n);
}
const server = http.createServer(async (q, r) => {
  const p = (q.url || '').split('?')[0];
  r.setHeader('content-type', 'application/json');
  try {
    if (q.method === 'POST' && (p === '/v1/embeddings' || p === '/embeddings') && process.env.AIVN_FAKE_EMBED_404 === '1') {
      r.statusCode = 404; return r.end('{}');
    }
    if (q.method === 'POST' && (p === '/v1/embeddings' || p === '/embeddings' || p === '/embedding')) {
      const b = await readBody(q);
      let inputs = b.input != null ? b.input : b.content;
      if (typeof inputs === 'string') inputs = [inputs];
      if (!Array.isArray(inputs)) inputs = [''];
      if (inputs.some((t) => words(t).length > ub)) {
        r.statusCode = 400;
        return r.end(JSON.stringify({ error: { message: 'input is too large to process. increase the physical batch size' } }));
      }
      if (p === '/embedding' && process.env.AIVN_FAKE_TOKEN_ROWS === '1') {
        return r.end(JSON.stringify([{ index: 0, embedding: [[3, 0], [0, 4]] }]));
      }
      const data = inputs.map((t, index) => ({ object: 'embedding', index, embedding: vec(t) }));
      if (p === '/embedding') return r.end(JSON.stringify(data.map((d) => ({ index: d.index, embedding: d.embedding }))));
      const tokens = inputs.reduce((s, t) => s + String(t).length, 0);
      return r.end(JSON.stringify({ object: 'list', model: 'fake', data, usage: { prompt_tokens: tokens, total_tokens: tokens } }));
    }
    if (q.method === 'POST' && p === '/tokenize') {
      if (process.env.AIVN_FAKE_TOKENIZE_FAIL === '1') { r.statusCode = 500; return r.end('{}'); }
      const b = await readBody(q);
      lastWords = words(b.content || '');
      const n = Math.max(1, lastWords.length);
      return r.end(JSON.stringify({ tokens: Array.from({ length: n }, (_, i) => i + 1) }));
    }
    if (q.method === 'POST' && p === '/detokenize') {
      if (process.env.AIVN_FAKE_DETOKENIZE_FAIL === '1') { r.statusCode = 500; return r.end('{}'); }
      const b = await readBody(q);
      const ids = Array.isArray(b.tokens) ? b.tokens : [];
      const content = ids.map((id) => lastWords[Number(id) - 1] || '').filter(Boolean).join(' ');
      return r.end(JSON.stringify({ content }));
    }
  } catch {}
  r.end('{}');
});
setTimeout(() => server.listen(port, '127.0.0.1'), healthDelay);
setInterval(() => {}, 1000);
